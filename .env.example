# .env.example — VA Automation Platform environment variables
# Copy this file to .env and fill in your values before running docker-compose.
#
#   cp .env.example .env
#
# NEVER commit .env to version control — it contains secrets.
# All defaults here are safe for local dev only.

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
DB_NAME=va_platform
DB_USER=va_user
DB_PASSWORD=va_dev_password_2024
DB_HOST=postgres
DB_PORT=5432

# Full DSN — used by FastAPI backend and Celery worker
DATABASE_URL=postgresql://va_user:va_dev_password_2024@postgres:5432/va_platform

# ---------------------------------------------------------------------------
# Redis — Celery broker and result backend
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# OWASP ZAP
# ---------------------------------------------------------------------------
# API key must match the value passed to ZAP via -config api.key=
# Change this before any non-local use.
ZAP_API_KEY=changeme_zap_dev_2024

# Internal Docker service URL — do not change for local dev
ZAP_BASE_URL=http://zap:8080

# ---------------------------------------------------------------------------
# Nuclei
# ---------------------------------------------------------------------------
# Path inside the nuclei container where templates are stored
NUCLEI_TEMPLATES_PATH=/root/nuclei-templates

# Internal Docker container name — used when exec-ing scan commands
NUCLEI_CONTAINER=va_nuclei

# ---------------------------------------------------------------------------
# FastAPI backend
# ---------------------------------------------------------------------------
# Set to "development" locally; "production" on any real deployment
APP_ENV=development

# X-API-Key header — required on all API requests except /health /docs /redoc
# Generate a strong key with: python -c "import secrets; print(secrets.token_hex(32))"
# CHANGE THIS before any non-local use.
API_KEY=changeme_api_key_dev_2024

# Secret key for signing JWTs (Phase 8 auth) — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_random_secret_key_before_use

# Allowed CORS origins — comma-separated, no trailing slash
# Use * for local dev only; restrict in production
CORS_ORIGINS=*

# ---------------------------------------------------------------------------
# Celery worker
# ---------------------------------------------------------------------------
# Number of concurrent scan tasks per worker process
WORKER_CONCURRENCY=2

# ---------------------------------------------------------------------------
# Grafana
# ---------------------------------------------------------------------------
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin_dev_2024

# ---------------------------------------------------------------------------
# Reports
# ---------------------------------------------------------------------------
# Shared volume path where ZAP and Nuclei write JSON reports
REPORTS_DIR=/reports

# ---------------------------------------------------------------------------
# Phase 8 — optional integrations (leave blank to disable)
# ---------------------------------------------------------------------------

# SMTP email alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Slack webhook notifications
SLACK_WEBHOOK_URL=

# Jira integration
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
